<?xml version="1.0" encoding="utf-8"?>
<!-- fitsSystemWindows sustituye el padding por el de las barras: el margen va en el LinearLayout de dentro -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B12"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/fb_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="#F4F4F6"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fb_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="#B9B8CC"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/fb_home"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="44dp"
            android:background="@drawable/alarm_btn_primary"
            android:gravity="center"
            android:textColor="#14143A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fb_open"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/alarm_btn_tonal"
            android:gravity="center"
            android:textColor="#F4F4F6"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
